rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Get user's role from the users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: Check if user is a specific role
    function hasRole(roleName) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserRole() == roleName;
    }

    // Helper: Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow read: if isAuthenticated() && (
        hasRole('System Administrator') || 
        hasRole('HR Officer')
      );
      // Allow authenticated users to create their own initial profile document
      allow create: if isAuthenticated() && isOwner(userId);
      // Profile updates & admin control restricted to HR Officers and Admins
      allow write: if isAuthenticated() && (
        hasRole('System Administrator') || 
        hasRole('HR Officer')
      );
      // Allow individual users to edit their own phone number and avatar photo details
      allow update: if isAuthenticated() && isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'officeDetails', 'supportingDocuments', 'permissions'])
      );
    }

    // 2. PROJECTS COLLECTION
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      // Writing project details restricted to PMs and Administrators
      allow write: if isAuthenticated() && (
        hasRole('Project Manager') || 
        hasRole('System Administrator')
      );
    }

    // 3. PROJECT FILES SUBCOLLECTION
    match /projectFiles/{fileId} {
      allow read: if isAuthenticated();
      // Uploader must be who they claim to be
      allow create: if isAuthenticated() && request.resource.data.senderOriginId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.senderOriginId == request.auth.uid ||
        hasRole('Project Manager') ||
        hasRole('System Administrator')
      );
    }

    // 4. BUDGETS & LEDGERS
    match /budgets/{budgetId} {
      allow read: if isAuthenticated() && (
        hasRole('Finance Officer') || 
        hasRole('Executive Director') || 
        hasRole('Project Manager') || 
        hasRole('System Administrator')
      );
      allow write: if isAuthenticated() && (
        hasRole('Finance Officer') || 
        hasRole('Executive Director') || 
        hasRole('System Administrator')
      );
    }

    // 5. EXPENSES & CLAIMS
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      // Allow any staff member to submit claims - amount must be a positive number
      allow create: if isAuthenticated() &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      // Approvals/Status changes restricted to Executive Director and Department Heads
      allow update, delete: if isAuthenticated() && (
        hasRole('Executive Director') || 
        hasRole('Department Head') || 
        hasRole('Finance Officer') || 
        hasRole('System Administrator')
      );
    }

    // 6. ASSETS & VENDORS (also used as the shared Resources/Inventory register)
    match /assetsAndVendors/{registerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        hasRole('Procurement & Logistics Officer') ||
        hasRole('Project Manager') ||
        hasRole('System Administrator')
      );
    }

    // 7. ORDERS
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        hasRole('Procurement & Logistics Officer') || 
        hasRole('System Administrator')
      );
    }

    // 8. AUDIT LOGS
    match /auditLogs/{logId} {
      // ONLY System Administrator can read cryptographic audit trails
      allow read: if isAuthenticated() && hasRole('System Administrator');
      // Allow writing from any logged-in user to register audit actions
      allow create: if isAuthenticated();
      allow update, delete: if false; // Logs are strictly immutable
    }

    // 9. STAFF REQUESTS (Leave / Docs)
    match /requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        hasRole('HR Officer') || 
        hasRole('System Administrator')
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Approvals restricted to HR and Admin
      allow update, delete: if isAuthenticated() && (
        hasRole('HR Officer') || 
        hasRole('System Administrator')
      );
    }

    // 10. COMMUNICATIONS (Announcements, directives & Media Tagging)
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        hasRole('Communications Officer') ||
        hasRole('HR Officer') ||
        hasRole('Executive Director') ||
        hasRole('Project Manager') ||
        hasRole('System Administrator')
      );
    }

    match /mediaLibrary/{mediaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        hasRole('Communications Officer') || 
        hasRole('System Administrator')
      );
    }

    // 11. OFFLINE SUBMISSIONS
    match /offlineSubmissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasRole('Field Officer');
      allow update, delete: if isAuthenticated() && hasRole('System Administrator');
    }

    // 12. REPORTS
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      // Author must be who they claim to be
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        hasRole('System Administrator')
      );
    }

    // 13. TRANSACTIONS
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        hasRole('Finance Officer') ||
        hasRole('System Administrator') ||
        hasRole('Project Manager') ||
        hasRole('Executive Director')
      ) &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update, delete: if isAuthenticated() && (
        hasRole('Finance Officer') ||
        hasRole('System Administrator') ||
        hasRole('Project Manager') ||
        hasRole('Executive Director')
      );
    }

    // 14. POLICY VAULT
    match /policyVault/{policyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        hasRole('HR Officer') ||
        hasRole('System Administrator')
      );
    }

    // Helper: M&E role is stored under two accepted spellings elsewhere in the app
    function isMEOfficer() {
      return hasRole('M&E Officer') || hasRole('Monitoring & Evaluation Officer');
    }

    // 15. M&E INDICATORS (covers indicators + their targets)
    match /indicators/{indicatorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isMEOfficer() ||
        hasRole('Project Manager') ||
        hasRole('System Administrator')
      );
    }

    // 16. BENEFICIARIES (shared by the M&E and Admin beneficiary views)
    match /beneficiaries/{beneficiaryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isMEOfficer() ||
        hasRole('Program Officer') ||
        hasRole('System Administrator')
      );
    }

    // 17. FIELD VISITS (data collection logs, field visit records, GIS points, quality review)
    match /fieldVisits/{visitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        hasRole('Field Officer') ||
        hasRole('Program Officer') ||
        isMEOfficer() ||
        hasRole('System Administrator')
      );
      // Quality-review status changes restricted to M&E and Admin
      allow update: if isAuthenticated() && (
        isMEOfficer() ||
        hasRole('System Administrator')
      );
      allow delete: if isAuthenticated() && hasRole('System Administrator');
    }

    // 18. SURVEYS
    match /surveys/{surveyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isMEOfficer() ||
        hasRole('System Administrator')
      );
    }

    // 19. ORGANIZATION EVENTS
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        hasRole('System Administrator') ||
        hasRole('Communications Officer') ||
        hasRole('HR Officer')
      );
    }

    // 20. INVOICES
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        hasRole('Finance Officer') ||
        hasRole('System Administrator')
      );
    }

    // 21. NOTIFICATIONS (in-app notification center)
    match /notifications/{notificationId} {
      // Users read their own notifications; Admin can read all for support.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasRole('System Administrator')
      );
      // Any authenticated user's action can generate a notification for
      // someone else (e.g. approving an expense notifies the submitter).
      allow create: if isAuthenticated();
      // Only the recipient (marking read) or Admin can modify/remove.
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasRole('System Administrator')
      );
    }

    // 22. ORG SETTINGS (approval thresholds, org-wide config)
    match /orgSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        hasRole('System Administrator') ||
        hasRole('Executive Director') ||
        hasRole('Finance Officer')
      );
    }
  }
}
